# Environment Variables for Kimance
# Copy this file to .env.local and fill in the values

# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Currency API
# Get your API key from: https://currencyapi.com/
CURRENCYAPI_KEY=your_currencyapi_key

# Site URL for Auth Redirects
# Your production domain (e.g., https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Connect
STRIPE_SECRET_KEY=your_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret

# Thirdstream KYC (requires an active API product subscription)
THIRDSTREAM_BASE_URL=your_thirdstream_api_base_url
THIRDSTREAM_CLIENT_ID=your_thirdstream_client_id
THIRDSTREAM_CLIENT_SECRET=your_thirdstream_client_secret

# Wise Platform
WISE_BASE_URL=https://api.wise-sandbox.com
WISE_CLIENT_ID=your_wise_client_id
WISE_CLIENT_SECRET=your_wise_client_secret

# Flinks
FLINKS_BASE_URL=your_flinks_api_base_url
FLINKS_CUSTOMER_ID=your_flinks_customer_id
FLINKS_INSTANCE=your_flinks_instance
FLINKS_SECRET=your_flinks_secret

# Marqeta
MARQETA_BASE_URL=https://sandbox-api.marqeta.com/v3
MARQETA_APPLICATION_TOKEN=your_marqeta_application_token
MARQETA_ADMIN_ACCESS_TOKEN=your_marqeta_admin_access_token

# Twilio Verify
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Thunes mobile-money payouts
THUNES_BASE_URL=your_thunes_api_base_url
THUNES_API_KEY=your_thunes_api_key
THUNES_API_SECRET=your_thunes_api_secret
